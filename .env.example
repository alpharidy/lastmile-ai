# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000)
PORT="3000"

# NIPOST DIGITAL POSTCODE API CONFIGURATION
# Set these when connecting to the live official NIPOST developer portal:
# NIPOST_API_URL: Official NIPOST postcode lookup endpoint (e.g. https://api.nipost.gov.ng/v1/postcodes)
NIPOST_API_URL=""

# NIPOST_API_KEY: Private bearer token or API key for NIPOST authentication (kept strictly server-side)
NIPOST_API_KEY=""

# NIPOST_CLIENT_ID: Registered client or merchant ID issued by NIPOST / FMCIDE
NIPOST_CLIENT_ID=""

